# dependencies
/node_modules
.DS_Store
.claude

# Astro build output
/dist
/.astro

# env
.env
.env.*
!.env.example
# Playwright MCP scratch output
.playwright-mcp/

# Width variants emitted by scripts/responsive-images.mjs at build time.
# The originals are committed; these are derived, so Netlify regenerates them.
/public/images/**/*-480.*
/public/images/**/*-768.*
/public/images/**/*-1200.*

# Local working files: Lighthouse reports, drafted emails and similar.
# Point-in-time artefacts, not part of the build.
/context-files/
