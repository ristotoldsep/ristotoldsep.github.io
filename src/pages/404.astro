---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../layouts/PageShell.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import Footer from '../components/sections/Footer.astro';
import { siteCopy } from '../i18n/site';
import { publishedProjects } from '../data/projects';
import { allServices } from '../data/services';
import { alternates, routes } from '../lib/routes';

const locale = 'en' as const;
const copy = siteCopy[locale];
const featured = publishedProjects().filter((p) => p.featured).slice(0, 3);
---

<BaseLayout
  lang={locale}
  title="Page not found | Risto Tõldsep"
  description="That page does not exist. Here is where everything else lives."
  alternates={alternates.home()}
  noindex
>
  <PageShell copy={copy} alternates={alternates.home()}>
    <PageHeader
      eyebrow="404"
      heading="That page does not exist"
      lede="The link may be out of date, or the page may have moved. Everything worth reading is one of these."
    >
      <div class="page-actions">
        <a href={routes.home(locale)} class="btn-primary">{copy.pages.home}</a>
        <a href={routes.workIndex(locale)} class="btn-ghost">{copy.nav.links.work}</a>
        <a href={routes.servicesIndex(locale)} class="btn-ghost">{copy.nav.links.services}</a>
      </div>
    </PageHeader>

    <section class="page-section">
      <h2 class="page-h2">{copy.pages.servicesIndex.heading}</h2>
      <div class="page-cards">
        {allServices.map((service) => (
          <a class="page-card" href={routes.service(locale, service.id)}>
            <div class="page-card-body">
              <h3>{service.i18n[locale].name}</h3>
              <p>{service.i18n[locale].summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="page-section">
      <h2 class="page-h2">{copy.pages.service.proof}</h2>
      <div class="page-cards">
        {featured.map((project) => (
          <a class="page-card" href={routes.project(locale, project.id)}>
            <div class="page-card-img">
              <img src={project.cover.src} alt={project.i18n[locale].imageAlt} loading="lazy" width={project.cover.width} height={project.cover.height} />
            </div>
            <div class="page-card-body">
              <h3>{project.name}</h3>
              <p>{project.i18n[locale].tagline}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <Footer copy={copy} />
  </PageShell>
</BaseLayout>
