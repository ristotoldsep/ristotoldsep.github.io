---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/pages/HomePage.astro';
import { siteCopy } from '../../i18n/site';
import { alternates } from '../../lib/routes';

const copy = siteCopy.et;
const alts = alternates.home();
---

<BaseLayout
  lang={copy.meta.lang}
  title={copy.meta.title}
  description={copy.meta.description}
  keywords={copy.meta.keywords}
  ogTitle={copy.meta.ogTitle}
  alternates={alts}
  pageType="ProfilePage"
  pageNodeIdSuffix="profilepage"
>
  <HomePage copy={copy} alternates={alts} />
</BaseLayout>
