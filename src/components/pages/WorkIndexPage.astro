---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../layouts/PageShell.astro';
import PageHeader from '../layout/PageHeader.astro';
import SectionCtaFull from '../sections/SectionCtaFull.astro';
import Footer from '../sections/Footer.astro';
import { siteCopy } from '../../i18n/site';
import type { Locale } from '../../data/types';
import { publishedProjects } from '../../data/projects';
import { alternates, routes } from '../../lib/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteCopy[locale];
const ui = copy.pages.workIndex;
const items = publishedProjects();

const SITE = Astro.site ?? new URL('https://ristotoldsep.eu');
const breadcrumbs = [
  { name: copy.pages.home, url: routes.home(locale) },
  { name: copy.nav.links.work, url: routes.workIndex(locale) },
];
---

<BaseLayout
  lang={locale}
  title={ui.title}
  description={ui.metaDescription}
  ogTitle={ui.heading}
  alternates={alternates.workIndex()}
  pageType="CollectionPage"
  pageNodeIdSuffix="worklist"
  breadcrumbs={breadcrumbs.map((c) => ({ name: c.name, url: new URL(c.url, SITE).href }))}
>
  <PageShell copy={copy} alternates={alternates.workIndex()}>
    <PageHeader eyebrow={ui.eyebrow} heading={ui.heading} lede={ui.lede} breadcrumbs={breadcrumbs} />

    <section class="page-section">
      <div class="page-cards">
        {items.map((project) => {
          const t = project.i18n[locale];
          return (
            <a class="page-card" href={routes.project(locale, project.id)}>
              <div class="page-card-img">
                <img src={project.cover.src} alt={t.imageAlt} loading="lazy" width={project.cover.width} height={project.cover.height} />
              </div>
              <div class="page-card-body">
                <div class="page-card-tags">
                  {project.cardTags.map((tag) => <span>{tag}</span>)}
                </div>
                <h2>{t.name ?? project.name}</h2>
                <p>{t.summary}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <SectionCtaFull copy={copy} />
    <Footer copy={copy} />
  </PageShell>
</BaseLayout>
