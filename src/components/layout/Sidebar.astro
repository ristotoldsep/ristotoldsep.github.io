---
import { socialLinks, type SiteCopy } from '../../i18n/site';
import { routes } from '../../lib/routes';

interface Props {
  copy: SiteCopy;
  isHome?: boolean;
}

const { copy, isHome = false } = Astro.props;
const home = routes.home(copy.locale);
const anchor = (hash: string) => (isHome ? `#${hash}` : `${home}#${hash}`);
---
<aside class="sidebar" id="sidebar" data-lenis-prevent>
  <div class="sidebar-inner" id="sidebarInner">

    <div class="sidebar-photo">
      <img src="/avatar.webp" alt={copy.sidebar.photoAlt} width="88" height="88" decoding="async">
    </div>

    <div class="sidebar-name">
      <p class="sidebar-title">Risto<br>Tõldsep</p>
      <p class="sidebar-role">{copy.sidebar.role}</p>
    </div>

    <div class="sidebar-data">
      {copy.sidebar.data.map((item, index) => (
        <div class="sidebar-data-item">
          <small>{item.label}</small>
          {index === copy.sidebar.data.length - 1 ? (
            <span class="avail-status"><span class="avail-dot"></span>{item.value}</span>
          ) : (
            <span>{item.value}</span>
          )}
        </div>
      ))}
    </div>

    <div class="sidebar-socials">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class="soc-btn" title={link.title}>
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" set:html={link.icon}></svg>
        </a>
      ))}
    </div>

    <nav class="sidebar-nav" aria-label={copy.sidebar.navAriaLabel}>
      <a href={anchor('home')}    class="sidebar-nav-link">{copy.nav.links.home}</a>
      <a href={routes.workIndex(copy.locale)}     class="sidebar-nav-link">{copy.nav.links.work}</a>
      <a href={routes.servicesIndex(copy.locale)} class="sidebar-nav-link">{copy.nav.links.services}</a>
      <a href={routes.about(copy.locale)}         class="sidebar-nav-link">{copy.nav.links.about}</a>
      <a href={anchor('skills')}  class="sidebar-nav-link">{copy.nav.links.skills}</a>
      <a href={anchor('contact')} class="sidebar-nav-link">{copy.nav.links.contact}</a>
    </nav>

    <a href={anchor('contact')} class="sidebar-cta">{copy.sidebar.cta}</a>

  </div>
</aside>
