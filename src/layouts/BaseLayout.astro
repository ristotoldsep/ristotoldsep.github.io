---
import '../styles/main.scss';
import type { Locale, Faq } from '../data/types';
import type { Alternates } from '../lib/routes';
import Analytics from '../components/global/Analytics.astro';
import {
  buildGraph,
  breadcrumbNode,
  pageNode,
  personNode,
  websiteNode,
  type SchemaNode,
} from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: Locale;
  ogTitle?: string;
  ogType?: 'website' | 'article' | 'profile';
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Required on every page: the EN/ET counterpart pair, always from
   *  `alternates.*()` in lib/routes. A new page cannot compile without
   *  declaring it, which is what stops hreflang going stale. */
  alternates: Alternates;
  canonical?: string;
  noindex?: boolean;
  pageType?: 'ProfilePage' | 'WebPage' | 'CollectionPage' | 'ItemPage' | 'AboutPage' | 'ContactPage';
  pageNodeIdSuffix?: string;
  extraPageTypes?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  faq?: Faq[];
  schema?: SchemaNode[];
  datePublished?: string;
  dateModified?: string;
}

const {
  title = 'Risto Tõldsep - WordPress Web Developer & Designer, Estonia',
  description = 'Risto Tõldsep is a freelance web developer and designer in Tallinn, Estonia. Custom websites, WordPress and WooCommerce stores, interactive frontends and AI-powered web tools.',
  keywords = 'risto toldsep, freelance web developer estonia, web designer estonia, wordpress developer estonia, woocommerce developer, custom websites, veebiarendaja tallinn, veebidisainer, kodulehe tegija, kodulehtede tegemine',
  lang = 'en',
  ogTitle = title,
  ogType = 'website',
  ogImage,
  ogImageAlt = 'Risto Tõldsep - Web Developer & Designer in Tallinn, Estonia',
  ogImageType = 'image/jpeg',
  ogImageWidth = 1200,
  ogImageHeight = 972,
  alternates,
  canonical,
  noindex = false,
  pageType = 'WebPage',
  pageNodeIdSuffix,
  extraPageTypes,
  breadcrumbs,
  faq,
  schema,
  datePublished,
  dateModified,
} = Astro.props;

// Canonical site origin (configured in astro.config.mjs)
const SITE = Astro.site ?? new URL('https://ristotoldsep.eu');
const canonicalURL = new URL(canonical ?? Astro.url.pathname, SITE);

// The default OG/social image is a lightweight version of the sidebar portrait
const ogImageURL = new URL(ogImage ?? '/og-image.jpg', SITE).href;

const hreflangs = [
  { hreflang: 'en', href: new URL(alternates.en, SITE).href },
  { hreflang: 'et', href: new URL(alternates.et, SITE).href },
  { hreflang: 'x-default', href: new URL(alternates.en, SITE).href },
];

const ogLocale = lang === 'et' ? 'et_EE' : 'en_US';
const ogLocaleAlt = lang === 'et' ? 'en_US' : 'et_EE';

// Structured data (JSON-LD) as a single @graph. Person and WebSite are
// site-wide; every page contributes its own page node plus whatever extra
// entities it describes, all pointing back at the same #person.
const jsonLd = buildGraph([
  personNode(SITE.origin, ogImageURL),
  websiteNode(SITE.origin, description),
  pageNode({
    origin: SITE.origin,
    url: canonicalURL.href,
    type: pageType,
    extraTypes: extraPageTypes,
    idSuffix: pageNodeIdSuffix,
    name: title,
    description,
    lang,
    hasBreadcrumb: Boolean(breadcrumbs?.length),
    faq,
    datePublished,
    dateModified,
  }),
  breadcrumbs?.length ? breadcrumbNode(canonicalURL.href, breadcrumbs) : null,
  ...(schema ?? []),
]);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('js');
      // If the bundle never runs, drop back to the visible base state.
      window.__rtReveal = setTimeout(function () { root.classList.remove('js'); }, 4000);
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Risto Tõldsep" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="theme-color" content="#0a0a0a" />

  <link rel="canonical" href={canonicalURL.href} />
  {hreflangs.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}

  <!-- Icons -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/favicon.ico" />

  <!-- Plain-text summaries for AI crawlers -->
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Risto Tõldsep" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogLocaleAlt} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Analytics />
</head>
<body>
  <slot />
  <script>
    import { initAll } from '../scripts/main';
    initAll();
  </script>
</body>
</html>
