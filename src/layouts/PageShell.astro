---
import Cursor from '../components/global/Cursor.astro';
import BackgroundLayers from '../components/global/BackgroundLayers.astro';
import MobileOverlay from '../components/global/MobileOverlay.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import TopNav from '../components/layout/TopNav.astro';
import type { SiteCopy } from '../i18n/site';
import type { Alternates } from '../lib/routes';

interface Props {
  copy: SiteCopy;
  alternates: Alternates;
  /** On the homepage the nav points at in-page anchors, elsewhere at routes. */
  isHome?: boolean;
}

const { copy, alternates, isHome = false } = Astro.props;
---
<Cursor />
<BackgroundLayers />

<div class="site-layout">
  <Sidebar copy={copy} isHome={isHome} />

  <div class="main-wrap" id="mainWrap">
    <TopNav copy={copy} alternates={alternates} isHome={isHome} />
    <MobileOverlay />

    <main class="content" id="content">
      <slot />
    </main>
  </div>
</div>
